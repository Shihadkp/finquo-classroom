# Database — SQLite for local dev, or a PostgreSQL URL (switch provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Agora (console.agora.io → project → App ID / Primary Certificate)
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Cloudflare R2 (dashboard → R2 → Manage API tokens → Object Read & Write)
# Optional: full S3 endpoint for a non-Cloudflare store (e.g. Backblaze B2: https://s3.us-west-004.backblazeb2.com)
R2_ENDPOINT=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="classroom-recordings"

# Aria Live — pick ONE:
#  (a) Free: any OpenAI-compatible endpoint. Groq (console.groq.com → API Keys, no card):
#      ARIA_BASE_URL="https://api.groq.com/openai/v1"  ARIA_MODEL="openai/gpt-oss-120b"  ARIA_REASONING_EFFORT="low"
#      Gemini also works: ARIA_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  ARIA_MODEL="gemini-2.5-flash"
ARIA_BASE_URL=""
ARIA_API_KEY=""
ARIA_MODEL=""
ARIA_REASONING_EFFORT=""
#  (b) Paid, best quality: Claude (console.anthropic.com). Used only when ARIA_BASE_URL is empty.
ANTHROPIC_API_KEY=""
